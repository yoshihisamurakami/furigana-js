{
  "manifest_version": 3,
  "name": "ふりがなふるよ",
  "version": "0.1",
  "permissions": ["activeTab","scripting","storage"],
  "host_permissions": ["https://localhost:8080/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "furigana.js"
    ]
  }],
  "action": {
    "default_icon": {
      "48": "icon/pen48.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon/pen16.png",
    "48": "icon/pen48.png",
    "128": "icon/pen128.png"
  }
}
